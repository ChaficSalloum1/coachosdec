{
  "expo": {
    "name": "CoachOS",
    "slug": "coachos",
    "scheme": "coachos",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.coachos.mobile",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.coachos.mobile",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "d625f8c5-ed49-43e3-a39b-9e54ae4a53f8"
      }
    },
    "plugins": [
      "./plugins/fix-fmt-consteval",
      [
        "expo-calendar",
        {
          "calendarPermission": "CoachOS needs access to your calendar to sync approved lessons with your device calendar.",
          "remindersPermission": "CoachOS does not use your reminders. This text is only here because the calendar component requires it to be declared."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-mail-composer",
      "expo-secure-store",
      "expo-video",
      "expo-web-browser"
    ]
  }
}
